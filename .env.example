# Windows Docker setup creates .env automatically with new random local secrets.
# Never copy the cloud environment's credentials to a Windows installation.
POSTGRES_PASSWORD=
JWT_SECRET=
APP_PORT=3001

# Only needed for development without Docker; fill in your own local details.
DATABASE_URL=
PORT=3001
NODE_ENV=development
# Account creation prompts securely; do not save an administrator password here.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
ENABLE_BACKUPS=false
BACKUP_DIR=backups
